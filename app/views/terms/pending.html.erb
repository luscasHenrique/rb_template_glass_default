<div class="w-full max-w-4xl mx-auto p-4 md:p-8 flex flex-col min-h-screen justify-center items-center">
  
  <div class="glass-card w-full">
    <div class="border-b border-white/10 pb-6 mb-6 text-center">
      <div class="w-16 h-16 bg-violet-600/20 rounded-2xl flex items-center justify-center mx-auto mb-4 border border-violet-500/30">
        <%= heroicon "document-text", options: { class: "w-8 h-8 text-violet-400" } %>
      </div>
      <h1 class="text-3xl font-bold text-white mb-2">Atualização dos Termos de Uso</h1>
      <p class="text-white/70">Versão do Documento: <span class="font-bold text-white"><%= @term.document_version %></span></p>
      <p class="text-white/50 text-sm mt-2">Para continuar utilizando nossa plataforma, você precisa ler e aceitar as novas políticas.</p>
    </div>

    <!-- Caixa de rolagem com o conteúdo do Termo -->
    <div class="bg-black/20 border border-white/5 rounded-xl p-6 mb-8 h-96 overflow-y-auto custom-scrollbar">
      <div class="prose prose-invert prose-violet max-w-none text-white/80 text-sm">
        <!-- Assume que o conteúdo foi salvo com formatação (ex: via ActionText ou Markdown) -->
        <%= raw @term.content %>
      </div>
    </div>

    <!-- Botões de Ação -->
    <div class="flex flex-col sm:flex-row items-center justify-end gap-4 border-t border-white/10 pt-6">
      
      <!-- Botão Recusar (Faz Logout) -->
      <%= render Shared::ButtonComponent.new(
          text: "Não Concordo (Sair)", 
          icon: "arrow-right-on-rectangle", 
          type: "button_to", 
          method: :delete, 
          path: decline_terms_path, 
          variant: "secondary",
          data: { turbo_confirm: "Se você não concordar, será desconectado do sistema. Tem certeza?" }
      ) %>

      <!-- Botão Aceitar (Assina Digitalmente) -->
      <%= render Shared::ButtonComponent.new(
          text: "Li e Aceito os Termos", 
          icon: "check-circle", 
          type: "button_to", 
          method: :post, 
          path: accept_terms_path, 
          variant: "primary"
      ) %>
      
    </div>
  </div>

</div>