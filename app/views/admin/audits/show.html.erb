<%= turbo_frame_tag "remote_modal" do %>
  <!-- Busca versões agrupadas APENAS se o transaction_id existir (pós-restart do servidor) -->
  <% related_versions = (@version.respond_to?(:transaction_id) && @version.transaction_id.present?) ? PaperTrail::Version.where(transaction_id: @version.transaction_id).order(id: :asc) : [@version] %>

  <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-sm p-4">
    <div class="glass-card w-full max-w-5xl max-h-[90vh] flex flex-col shadow-2xl p-0 overflow-hidden relative">
      
      <!-- Cabeçalho -->
      <div class="flex items-center justify-between p-6 border-b border-white/10 bg-white/5 shrink-0">
        <div>
          <h3 class="text-xl font-bold text-white flex items-center gap-2">
            <%= heroicon "magnifying-glass-circle", options: { class: "w-6 h-6 text-violet-400" } %>
            Inspeção de Log #<%= @version.id %>
            <% if related_versions.size > 1 %>
              <span class="inline-flex items-center gap-1 px-2 py-1 rounded-md bg-blue-500/20 border border-blue-500/30 text-xs font-medium text-blue-200 ml-2">
                <%= heroicon "link", options: { class: "w-3 h-3" } %> Transação Múltipla
              </span>
            <% end %>
          </h3>
          <p class="text-sm text-white/50 mt-1">
            Data da Ocorrência: <%= @version.created_at.strftime("%d/%m/%Y às %H:%M:%S") %>
            <span class="ml-2 opacity-50">| Hash: <%= @version.transaction_id || "N/A (Pré-Migração)" %></span>
          </p>
        </div>
        <%= link_to heroicon("x-mark", options: { class: "w-6 h-6" }), 
            admin_audits_path, 
            class: "text-white/50 hover:text-white transition-colors", 
            data: { turbo_frame: "_top" } %>
      </div>

      <!-- Corpo com Scroll -->
      <div class="p-6 overflow-y-auto custom-scrollbar flex-1">
        
        <!-- DASHBOARD DE CONTEXTO (METADADOS) -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
          
          <!-- CARD 1: O AUTOR (Quem fez) -->
          <div class="bg-black/20 p-4 rounded-xl border border-white/5 shadow-inner flex flex-col justify-center">
            <span class="block text-xs font-semibold text-white/50 uppercase tracking-wider mb-2">Autor da Ação</span>
            <div class="flex items-center gap-2">
              <span class="font-medium text-white truncate">
                <%= @user&.email || "Sistema / ID: #{@version.whodunnit}" %>
              </span>
              <% if @user&.respond_to?(:role) %>
                <%= render Shared::BadgeComponent.new(text: @user.role.upcase, variant: @user.admin? || @user.master? ? "warning" : "info") %>
              <% end %>
            </div>
          </div>

          <!-- CARD 2: O ALVO (Quem sofreu a ação) -->
          <% target_item = @version.item || @version.reify %>
          <div class="bg-black/20 p-4 rounded-xl border border-white/5 shadow-inner flex flex-col justify-center">
            <span class="block text-xs font-semibold text-white/50 uppercase tracking-wider mb-2">Alvo Afetado</span>
            
            <%# Inteligência de Negócio: Tenta inferir o Usuário se a tabela for User ou Profile %>
            <% base_user = target_item if @version.item_type == 'User' %>
            <% base_user = target_item.user if @version.item_type == 'Profile' && target_item.respond_to?(:user) && target_item.user.present? %>
            
            <% if base_user.present? && base_user.respond_to?(:email) %>
              <div class="flex flex-col">
                <div class="flex items-center gap-2 mb-1">
                  <span class="font-medium text-white truncate"><%= base_user.email %></span>
                  <%= render Shared::BadgeComponent.new(text: base_user.role.upcase, variant: base_user.admin? || base_user.master? ? "warning" : "info") if base_user.respond_to?(:role) %>
                </div>
                <span class="text-xs text-white/50">Origem: <%= @version.item_type %> #<%= @version.item_id %></span>
              </div>
            <% else %>
              <span class="font-medium text-white block">
                <%= @version.item_type %> <span class="text-white/50 ml-1">#<%= @version.item_id %></span>
              </span>
            <% end %>
          </div>

          <!-- CARD 3: IMPACTO -->
          <div class="bg-black/20 p-4 rounded-xl border border-white/5 shadow-inner flex flex-col justify-center">
            <span class="block text-xs font-semibold text-white/50 uppercase tracking-wider mb-2">Volume da Transação</span>
            <span class="font-medium text-white block">
              <%= related_versions.size %> tabela(s) afetada(s)
            </span>
          </div>
        </div>

        <h4 class="text-sm font-semibold text-white/70 uppercase tracking-wider mb-4 border-b border-white/10 pb-2">
          Raio-X dos Dados Agrupados
        </h4>

        <!-- LISTAGEM DE DETALHES DAS MUTAÇÕES -->
        <div class="space-y-8">
          <% related_versions.each do |version| %>
            <div class="bg-white/5 rounded-xl border border-white/10 overflow-hidden">
              <div class="p-3 bg-black/40 border-b border-white/10 flex items-center justify-between">
                <span class="font-mono text-sm font-bold text-violet-300">
                  Tabela: <%= version.item_type %> <span class="text-white/40 ml-1">#<%= version.item_id %></span>
                </span>
                
                <% case version.event %>
                <% when 'create' %>
                  <span class="text-xs font-bold text-emerald-400 bg-emerald-400/10 px-2 py-1 rounded">CRIAÇÃO</span>
                <% when 'update' %>
                  <span class="text-xs font-bold text-amber-400 bg-amber-400/10 px-2 py-1 rounded">ATUALIZAÇÃO</span>
                <% when 'destroy' %>
                  <span class="text-xs font-bold text-rose-400 bg-rose-400/10 px-2 py-1 rounded">EXCLUSÃO</span>
                <% end %>
              </div>
              
              <div class="p-4">
                <% if version.event == 'update' && version.changeset.present? %>
                  <div class="space-y-4">
                    <% version.changeset.each do |attribute, values| %>
                      <div class="bg-black/30 rounded-lg p-4 border border-white/5">
                        <span class="block text-sm font-bold text-white mb-2"><%= attribute %></span>
                        <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
                          <div class="bg-rose-500/10 border border-rose-500/20 rounded p-4 text-sm text-rose-200 whitespace-pre-wrap max-h-60 overflow-y-auto custom-scrollbar">
                            <span class="block text-xs text-rose-400/70 mb-2 uppercase font-semibold">Valor Anterior (De):</span>
                            <%= values[0].blank? ? "< Vazio / Nulo >" : values[0] %>
                          </div>
                          <div class="bg-emerald-500/10 border border-emerald-500/20 rounded p-4 text-sm text-emerald-200 whitespace-pre-wrap max-h-60 overflow-y-auto custom-scrollbar">
                            <span class="block text-xs text-emerald-400/70 mb-2 uppercase font-semibold">Novo Valor (Para):</span>
                            <%= values[1].blank? ? "< Vazio / Nulo >" : values[1] %>
                          </div>
                        </div>
                      </div>
                    <% end %>
                  </div>
                <% elsif version.event == 'destroy' && version.reify.present? %>
                  <div class="bg-rose-500/5 border border-rose-500/20 rounded-xl p-4">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                      <% version.reify.attributes.except('id', 'created_at', 'updated_at').each do |attr, value| %>
                        <div class="bg-black/40 rounded p-3 border border-white/5">
                          <span class="block text-xs text-white/40 uppercase tracking-wider mb-1"><%= attr %></span>
                          <span class="text-sm text-white/90 break-all"><%= value.blank? ? "N/A" : value %></span>
                        </div>
                      <% end %>
                    </div>
                  </div>
                <% elsif version.event == 'create' %>
                  <p class="text-sm text-emerald-200/60 text-center py-2">
                    Registro de base inserido nesta tabela. (Consulte o banco para ver os dados completos)
                  </p>
                <% else %>
                  <p class="text-white/30 text-sm text-center">Nenhum detalhe adicional disponível.</p>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>

      </div>
    </div>
  </div>
<% end %>