<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <title>Acesso - Template Glass</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-cover bg-center bg-no-repeat bg-fixed font-sans antialiased flex items-center justify-center p-4 md:p-8" 
        style="background-image: url('<%= asset_path('wall_08.png') %>');">
    
    <main class="w-full max-w-md bg-white/10 backdrop-blur-xl border border-white/20 rounded-3xl p-8 shadow-2xl relative overflow-hidden">
      <div class="absolute top-0 left-0 w-full h-1/2 bg-gradient-to-b from-white/10 to-transparent pointer-events-none"></div>

      <div class="relative z-10">
        <%= yield %>
      </div>
    </main>

    <!-- Sintaxe O.O. corrigida para os componentes globais -->
    <%= render Shared::FlashMessagesComponent.new(flash: flash) %>
    <%= render Shared::CookieBannerComponent.new %>
  </body>
</html>