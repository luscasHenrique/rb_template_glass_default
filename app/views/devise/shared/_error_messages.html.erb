<% if resource.errors.any? %>
  <div class="mb-6 p-4 rounded-xl bg-rose-500/10 border border-rose-500/50 text-rose-100 shadow-[0_0_15px_rgba(225,29,72,0.2)]" data-turbo-temporary>
    <h3 class="text-sm font-bold mb-2 flex items-center gap-2">
      <%= heroicon "exclamation-triangle", options: { class: "w-5 h-5" } %>
      <%= I18n.t("errors.messages.not_saved", count: resource.errors.count, resource: resource.class.model_name.human.downcase) %>
    </h3>
    <ul class="list-disc list-inside text-xs space-y-1 ml-1 text-rose-200/80">
      <% resource.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>