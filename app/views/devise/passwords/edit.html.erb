<div class="w-full">
  <div class="text-center mb-8">
    <h2 class="text-3xl font-bold text-white mb-2">Criar nova senha</h2>
    <p class="text-white/70 text-sm">Sua nova senha deve ser segura</p>
  </div>

  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: "space-y-6" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>
    <%= f.hidden_field :reset_password_token %>

    <% label_text = @minimum_password_length ? "Nova Senha (mínimo #{@minimum_password_length} caracteres)" : "Nova Senha" %>

    <%= render Shared::PasswordInputComponent.new(
               form: f, field: :password, label: label_text, placeholder: "Nova senha",
               input_data: { autocomplete: "new-password" },
               variant: resource.errors[:password].any? ? "danger" : "default") %>

    <%= render Shared::PasswordInputComponent.new(
               form: f, field: :password_confirmation, label: "Confirmar nova senha", placeholder: "Repita a senha",
               input_data: { autocomplete: "new-password" },
               variant: resource.errors[:password_confirmation].any? ? "danger" : "default") %>

    <div class="pt-2">
      <%= render Shared::ButtonComponent.new(
                 text: "Salvar nova senha", type: "submit", variant: "primary", 
                 custom_class: "w-full", loading_text: "Salvando...") %>
    </div>
  <% end %>

  <%= render "devise/shared/links" %>
</div>