<div class="w-full">
  <div class="text-center mb-8">
    <h2 class="text-3xl font-bold text-white mb-2">Configurações da Conta</h2>
    <p class="text-white/70 text-sm">Atualize seus dados de acesso</p>
  </div>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, class: "space-y-6" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <%= render Shared::InputComponent.new(
               form: f, field: :email, type: "email", label: "E-mail", placeholder: "seu@email.com",
               variant: resource.errors[:email].any? ? "danger" : "default") %>

    <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
      <div class="text-xs text-amber-400 bg-amber-400/10 p-3 rounded-lg border border-amber-400/20">
        Aguardando confirmação para: <%= resource.unconfirmed_email %>
      </div>
    <% end %>

    <div class="p-4 rounded-2xl bg-white/5 border border-white/10 space-y-4">
      <h3 class="text-sm font-semibold text-white/80 mb-2">Alterar Senha</h3>
      
      <%= render Shared::PasswordInputComponent.new(
                 form: f, field: :password, label: "Nova Senha (deixe em branco para não alterar)", 
                 placeholder: "Nova senha", input_data: { autocomplete: "new-password" },
                 variant: resource.errors[:password].any? ? "danger" : "default") %>

      <%= render Shared::PasswordInputComponent.new(
                 form: f, field: :password_confirmation, label: "Confirmar Nova Senha", 
                 placeholder: "Repita a nova senha", input_data: { autocomplete: "new-password" },
                 variant: resource.errors[:password_confirmation].any? ? "danger" : "default") %>
    </div>

    <div class="pt-2 border-t border-white/10">
      <%= render Shared::PasswordInputComponent.new(
                 form: f, field: :current_password, label: "Senha Atual (obrigatório para salvar as alterações)", 
                 placeholder: "Sua senha atual", input_data: { autocomplete: "current-password" },
                 variant: resource.errors[:current_password].any? ? "danger" : "default") %>
    </div>

    <div class="pt-4 flex items-center justify-between gap-4">
      <%= link_to "Voltar", :back, class: "text-sm text-white/50 hover:text-white transition-colors" %>
      
      <%= render Shared::ButtonComponent.new(
                 text: "Atualizar Conta", type: "submit", variant: "primary", 
                 loading_text: "Salvando...") %>
    </div>
  <% end %>

  <div class="mt-12 pt-6 border-t border-rose-500/20 text-center">
    <h3 class="text-rose-400 font-bold mb-2">Zona de Perigo</h3>
    <p class="text-xs text-white/50 mb-4">Insatisfeito? Esta ação é irreversível.</p>
    
    <%= render Shared::ButtonComponent.new(
        text: "Cancelar minha conta",
        icon: "trash",
        type: "button_to",
        method: :delete,
        path: registration_path(resource_name),
        variant: "outline-danger",
        data: { turbo_confirm: "Tem certeza absoluta que deseja excluir sua conta?" }
    ) %>
  </div>
</div>