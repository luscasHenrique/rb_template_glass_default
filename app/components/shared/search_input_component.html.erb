<div class="space-y-1 w-full <%= @custom_class %>">
  <% if @label.present? %>
    <!-- Consome a cor dinâmica (vermelho em caso de erro) -->
    <%= @form.label @field, @label, class: label_color %>
  <% end %>

  <div class="glass-search-wrapper relative">
    <!-- Ícone de Lupa -->
    <div class="absolute inset-y-0 left-0 flex items-center pl-4 pointer-events-none text-white/50 z-10">
      <%= heroicon "magnifying-glass", options: { class: "w-5 h-5" } %>
    </div>
    
    <!-- Composição: O InputComponent assumirá as bordas vermelhas e a mensagem se houver erro -->
    <%= render Shared::InputComponent.new(
        form: @form, 
        field: @field, 
        placeholder: @placeholder, 
        value: @value,
        custom_class: "pl-11 w-full" 
    ) %>
  </div>
</div>