<div class="space-y-1 w-full" data-controller="password-visibility">
  <% if label.present? %>
    <%= form.label field, label, class: label_color %>
  <% end %>

  <div class="relative">
    <%= form.password_field field, class: final_classes, placeholder: placeholder, data: merged_input_data %>
    
    <button type="button" 
            data-action="click->password-visibility#toggle" 
            tabindex="-1"
            class="absolute inset-y-0 right-0 flex items-center pr-4 transition-colors cursor-pointer <%= icon_color %>">
            
      <!-- SVG: Eye Slash (Fechado) via Heroicon -->
      <span data-password-visibility-target="iconClosed">
        <%= heroicon "eye-slash", options: { class: "w-5 h-5" } %>
      </span>
      
      <!-- SVG: Eye (Aberto) via Heroicon -->
      <span data-password-visibility-target="iconOpen" class="hidden">
        <%= heroicon "eye", options: { class: "w-5 h-5" } %>
      </span>
      
    </button>
  </div>

  <!-- ARQUITETURA LIMPA: Injeção do Feedback Visual de Erro -->
  <% if has_error? %>
    <p class="text-xs text-rose-400 mt-1.5 flex items-center gap-1.5 animate-pulse">
      <%= heroicon "exclamation-circle", options: { class: "w-4 h-4 shrink-0" } %>
      <%= error_message %>
    </p>
  <% end %>
</div>