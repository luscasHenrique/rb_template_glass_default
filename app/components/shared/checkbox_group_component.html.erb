<div class="space-y-2 w-full <%= @custom_class %>">
  <% if @label.present? %>
    <div class="<%= label_color %>"><%= @label %></div>
  <% end %>
  
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
    <% @collection.each do |text, val| %>
      <% if @type == :radio %>
        <%= render Shared::RadioButtonComponent.new(form: @form, field: @field, value: val, label: text) %>
      <% else %>
        <%= render Shared::CheckboxComponent.new(
            form: @form, 
            field: @field, 
            label: text, 
            custom_class: "p-3", 
            checked_value: val, 
            unchecked_value: nil, 
            multiple: true
        ) %>
      <% end %>
    <% end %>
  </div>

  <!-- ARQUITETURA LIMPA: Injeção do Feedback Visual de Erro -->
  <% if has_error? %>
    <p class="text-xs text-rose-400 mt-1 flex items-center gap-1.5 animate-pulse">
      <%= heroicon "exclamation-circle", options: { class: "w-4 h-4 shrink-0" } %>
      <%= error_message %>
    </p>
  <% end %>
</div>