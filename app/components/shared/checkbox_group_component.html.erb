<div class="space-y-2 <%= @custom_class %>">
  <% if @label.present? %>
    <div class="glass-label"><%= @label %></div>
  <% end %>
  
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
    <% @collection.each do |text, val| %>
      <% if @type == :radio %>
        <%= render Shared::RadioButtonComponent.new(form: @form, field: @field, value: val, label: text) %>
      <% else %>
        <!-- INTEGRAÇÃO CORRETA: Passando os valores estruturais em vez de usar data-attributes -->
        <%= render Shared::CheckboxComponent.new(
            form: @form, 
            field: @field, 
            label: text, 
            custom_class: "p-3", 
            checked_value: val, 
            unchecked_value: nil, 
            multiple: true
        ) %>
      <% end %>
    <% end %>
  </div>
</div>