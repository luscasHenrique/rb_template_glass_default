<!-- Conectamos o Stimulus (data-controller="modal") -->
<dialog id="<%= @id %>" class="glass-modal-overlay  transition-opacity duration-200" data-controller="modal">
  <div class="glass-modal-dialog <%= size_class %>">
    <% if header.present? %>
      <div class="p-6 border-b border-white/10 flex justify-between items-center">
        <h3 class="text-xl font-bold text-white"><%= header %></h3>
        
        <!-- Botão X dispara o close do Stimulus -->
        <button type="button" class="text-white/50 hover:text-white cursor-pointer shrink-0 outline-none" data-action="click->modal#close">
          <%= heroicon "x-mark", options: { class: "w-6 h-6" } %>
        </button>
      </div>
    <% end %>

    <div class="p-6">
      <%= body %>
    </div>

    <% if footer.present? %>
      <div class="p-4 border-t border-white/10 flex justify-end gap-3 bg-black/20 rounded-b-3xl">
        <%= footer %>
      </div>
    <% end %>
  </div>
</dialog>