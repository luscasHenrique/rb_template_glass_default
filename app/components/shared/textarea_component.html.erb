<div class="space-y-1 w-full">
  <% if label.present? %>
    <!-- Arquitetura Limpa: Rótulo reativo ao estado do componente -->
    <%= form.label field, label, class: label_color %>
  <% end %>
  
  <%= form.text_area field, class: final_classes, placeholder: placeholder, data: input_data %>
</div>