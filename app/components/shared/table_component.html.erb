<div class="glass-card p-0 <%= @custom_class %> flex flex-col relative z-0" data-controller="table">
  
  <!-- ZONA DO TOPO: Aplica arredondamento nas quinas superiores (rounded-t-3xl) e Z-index alto -->
  <% if filters? || actions? %>
    <div class="p-4 border-b border-white/10 bg-white/5 flex flex-col xl:flex-row xl:items-end justify-between gap-4 relative z-20 rounded-t-3xl">
      <div class="flex-1 w-full">
        <%= filters if filters? %>
      </div>
      <div class="shrink-0 flex items-center gap-2">
        <%= actions if actions? %>
      </div>
    </div>
  <% end %>

  <!-- ZONA DA BASE (Dados): Recupera o overflow-hidden para CORTAR o vazamento, aplicando arredondamento inferior -->
  <% radius_bottom = (filters? || actions?) ? "rounded-b-3xl" : "rounded-3xl" %>
  <div class="flex-1 flex flex-col overflow-hidden <%= radius_bottom %> relative z-10 isolate">
    
    <div class="w-full custom-scrollbar <%= @max_height || '' %> <%= @max_height ? 'overflow-y-auto' : 'overflow-x-auto' %>">
      <table class="w-full text-left text-sm text-white/80 whitespace-nowrap relative">
        <thead class="bg-white/5 border-b border-white/10 text-white/90 sticky top-0 z-10 backdrop-blur-xl">
          <tr>
            <% if @selectable %>
              <th class="px-6 py-4 w-12 text-center">
                <!-- ARQUITETURA LIMPA: Invoca o componente em modo 'standalone' (sem formulário) -->
                <%= render Shared::CheckboxComponent.new(
                    form: nil,
                    field: "master_checkbox",
                    variant: "minimal",
                    input_data: { 
                      table_target: "masterCheckbox", 
                      action: "change->table#toggleAll" 
                    }
                ) %>
              </th>
            <% end %>

            <% @headers.each do |header| %>
              <% align_class = header.is_a?(Hash) && header[:align] == "right" ? "text-right" : "text-left" %>
              <% text = header.is_a?(Hash) ? header[:text] : header %>
              <th class="px-6 py-4 font-semibold <%= align_class %>"><%= text %></th>
            <% end %>
          </tr>
        </thead>
        
        <tbody class="divide-y divide-white/5">
          <%= content %>
        </tbody>
      </table>
    </div>

    <% if @pagination.present? %>
      <div class="p-4 border-t border-white/10 bg-black/10 flex items-center justify-between">
        <%= @pagination %>
      </div>
    <% end %>

  </div>
</div>