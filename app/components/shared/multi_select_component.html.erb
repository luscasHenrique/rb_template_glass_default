<div class="space-y-1 w-full">
  <% if @label.present? %>
    <div class="glass-label"><%= @label %></div>
  <% end %>
  
  <div class="glass-input glass-input-default flex flex-wrap gap-2 p-2 min-h-[48px] items-center cursor-pointer">
    <% @selected_items.each do |item| %>
      <span class="glass-tag">
        <%= item[:text] %>
        <button type="button" class="hover:text-white ml-1 shrink-0">
          <!-- Ícone de remoção padronizado e dinâmico -->
          <%= heroicon "x-mark", options: { class: "w-3 h-3" } %>
        </button>
      </span>
    <% end %>
    
    <span class="text-white/30 text-sm ml-2 select-none"><%= @selected_items.empty? ? "Selecione as opções..." : "" %></span>
  </div>
</div>