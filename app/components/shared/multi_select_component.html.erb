<!-- 1. Remoção do space-y-1 para impedir que o Tailwind injete margens invisíveis entre a Label e o Gatilho -->
<div class="w-full relative flex flex-col justify-end" data-controller="multi-select" data-action="click@window->multi-select#hide">
  
  <% if @label.present? %>
    <!-- Usando mb-1 explícito para igualar o comportamento das outras labels do Design System -->
    <label class="glass-label mb-1"><%= @label %></label>
  <% end %>

  <!-- TRIGGER: A altura agora é ditada exclusivamente pela classe glass-input-md, idêntica aos outros inputs -->
  <div data-action="click->multi-select#toggle" class="glass-input glass-input-default glass-input-md flex flex-wrap items-center gap-1.5 cursor-pointer transition-all min-h-[48px] m-0">
    
    <div data-multi-select-target="tagContainer" class="flex flex-wrap gap-1.5 empty:hidden pointer-events-auto">
      <!-- Tags injetadas via Stimulus -->
    </div>
    
    <span data-multi-select-target="placeholder" class="text-white/40 truncate select-none flex-1 leading-normal"><%= @placeholder %></span>
    
    <%= heroicon "chevron-down", options: { class: "w-5 h-5 text-white/50 ml-auto shrink-0 transition-transform duration-200", "data-multi-select-target": "chevron" } %>
  </div>

  <!-- Dropdown Flutuante Premium com Pesquisa -->
  <div data-multi-select-target="dropdown" class="glass-select-dropdown absolute z-50 w-full top-full mt-2 !max-h-80 flex-col hidden shadow-2xl overflow-hidden rounded-xl border border-white/10 bg-gray-900/95 backdrop-blur-xl">
    
    <div class="p-3 border-b border-white/10 sticky top-0 bg-gray-900/95 backdrop-blur-xl z-10">
      <div class="glass-search-wrapper">
        <div class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none text-white/50 z-10">
          <%= heroicon "magnifying-glass", options: { class: "w-4 h-4" } %>
        </div>
        <input type="text" data-multi-select-target="searchInput" data-action="input->multi-select#filter" class="glass-input glass-input-sm pl-9 w-full bg-black/40 border-white/5" placeholder="Pesquisar opções...">
      </div>
    </div>

    <ul class="py-2 overflow-y-auto custom-scrollbar flex-1 max-h-60">
      <% @collection.each do |text, value| %>
        <li data-multi-select-target="option"
            data-value="<%= value %>"
            data-text="<%= text %>"
            data-action="click->multi-select#select"
            class="px-4 py-3 text-white/80 hover:bg-white/5 cursor-pointer transition-colors flex items-center justify-between group">
          
          <span class="text-sm font-medium"><%= text %></span>
          
          <div class="w-5 h-5 rounded-md border border-white/20 flex items-center justify-center transition-all duration-200 group-data-[selected='true']:<%= check_color %> group-data-[selected='true']:border-transparent">
            <%= heroicon "check", options: { class: "w-3 h-3 text-white opacity-0 group-data-[selected='true']:opacity-100 transition-opacity duration-200" } %>
          </div>
        </li>
      <% end %>
    </ul>
    
    <div class="p-3 border-t border-white/10 bg-black/40 flex justify-between items-center sticky bottom-0">
      <button type="button" data-action="click->multi-select#clear" class="text-sm text-white/50 hover:text-rose-400 transition-colors flex items-center gap-1 outline-none">
        <%= heroicon "trash", options: { class: "w-4 h-4" } %> Limpar
      </button>
      <button type="button" data-action="click->multi-select#close" class="glass-btn glass-btn-xsm glass-btn-primary rounded-lg">Aplicar</button>
    </div>
  </div>
  
  <template data-multi-select-target="tagTemplate">
    <span class="inline-flex items-center gap-1 px-2 py-1 rounded-md text-xs font-medium <%= tag_classes %> transition-transform hover:scale-105" data-value="VALUE_PLACEHOLDER">
      TEXT_PLACEHOLDER
      <button type="button" data-action="click->multi-select#remove" class="hover:text-white ml-1 shrink-0 outline-none">
        <%= heroicon "x-mark", options: { class: "w-3 h-3 pointer-events-none" } %>
      </button>
    </span>
  </template>

  <!-- 2. O Segredo: Input nativo múltiplo oculto MOVIDO PARA O FINAL, fora do fluxo visual de renderização -->
<%= @form.select @field, @collection, {}, { multiple: true, class: "hidden", data: { multi_select_target: "hiddenSelect" } } %>
</div>