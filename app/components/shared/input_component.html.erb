<div class="space-y-1 w-full">
  <% if label.present? %>
    <%= form.label field, label, class: label_color %>
  <% end %>
  
  <!-- O Rails agora fará o Data Binding automático no Edit usando as input_options dinâmicas -->
  <% if type == "date" %>
    <%= form.date_field field, input_options %>
  <% elsif type == "email" %>
    <%= form.email_field field, input_options %>
  <% elsif type == "number" %>
    <%= form.number_field field, input_options %>
  <% elsif type == "password" %>
    <%= form.password_field field, input_options %>
  <% elsif type == "datetime-local" %>
    <%= form.datetime_field field, input_options %>
  <% else %>
    <%= form.text_field field, input_options %>
  <% end %>
</div>