<div class="space-y-1 w-full">
  <% if label.present? %>
    <%= form.label field, label, class: label_color %>
  <% end %>
  
  <!-- O Rails fará o Data Binding automático no Edit usando as input_options dinâmicas -->
  <% if type == "date" %>
    <%= form.date_field field, input_options %>
  <% elsif type == "email" %>
    <%= form.email_field field, input_options %>
  <% elsif type == "number" %>
    <%= form.number_field field, input_options %>
  <% elsif type == "password" %>
    <%= form.password_field field, input_options %>
  <% elsif type == "datetime-local" %>
    <%= form.datetime_field field, input_options %>
  <% else %>
    <%= form.text_field field, input_options %>
  <% end %>

  <!-- ARQUITETURA LIMPA: Injeção do Feedback Visual de Erro -->
  <% if has_error? %>
    <p class="text-xs text-rose-400 mt-1.5 flex items-center gap-1.5 animate-pulse">
      <%= heroicon "exclamation-circle", options: { class: "w-4 h-4 shrink-0" } %>
      <%= error_message %>
    </p>
  <% end %>
</div>