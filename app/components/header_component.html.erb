<header class="glass-card-sm flex items-center justify-between mb-6 sticky top-4 z-30">
  <div class="flex items-center gap-4">
    
    <!-- ARQUITETURA LIMPA: Consumindo o ButtonComponent Global -->
    <!-- Passamos p-0 para tirar o padding padrão e variant none para manter o fundo transparente -->
    <%= render Shared::ButtonComponent.new(
        icon: "bars-3",
        type: "button",
        variant: "none",
        custom_class: "md:hidden p-0 text-white/70 hover:text-white cursor-pointer shrink-0 border-none shadow-none focus:ring-0",
        onclick: "window.dispatchEvent(new CustomEvent('mobile-menu:toggle'))"
    ) %>
    
    <h1 class="text-xl font-bold text-white"><%= @title %></h1>
  </div>
  
  <div class="flex items-center gap-4">
    <% if @user %>
      <div class="text-right hidden sm:block">
        <p class="text-sm font-medium text-white"><%= @user.profile&.first_name || "Usuário" %></p>
        <p class="text-[10px] uppercase tracking-wider text-white/50"><%= @user.role %></p>
      </div>
      
      <div class="h-10 w-10 rounded-full bg-violet-500/20 border border-violet-500/50 flex items-center justify-center text-white overflow-hidden shadow-inner shrink-0">
        <% if @user.profile&.avatar_url.present? %>
          <%= image_tag @user.profile.avatar_url, class: "w-full h-full object-cover" %>
        <% else %>
          <!-- PADRONIZAÇÃO: Consumindo o Heroicon dinâmico em vez de SVG sujo -->
          <%= heroicon "user", options: { class: "w-5 h-5 text-white/70" } %>
        <% end %>
      </div>
    <% end %>
  </div>
</header>